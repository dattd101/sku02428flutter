# Để trống = chấp nhận mọi Origin (phù hợp native Flutter client).
# Nếu có Flutter Web, có thể giới hạn: https://your-flutter-web.example
ALLOWED_ORIGINS=

# Thời gian giữ session khi app mất mạng để reconnect (ms)
DISCONNECT_GRACE_MS=8000

# TTL của một chat (ms), mặc định 60 phút
CHAT_TTL_MS=3600000
